# Copy to server/.env (local) or set these as environment variables on your host.

# PostgreSQL connection string. Neon example:
#   postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://pp:pp@localhost:5432/projectpulse
# DATABASE_SSL=true            # force TLS if your URL has no ?sslmode=

# REQUIRED: long random string used to sign login tokens.  Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

PORT=3000
NODE_ENV=development

# Create the first administrator automatically on first start (only if no admin exists yet).
# Remove ADMIN_PASSWORD from the host afterwards.
# ADMIN_EMAIL=admin@yourschool.edu
# ADMIN_PASSWORD=choose-a-strong-password
# ADMIN_NAME=System Administrator

# Demo buttons on the login page (accounts like admin@demo.com / demo123). KEEP false IN PRODUCTION.
ENABLE_DEMO_LOGIN=false

# Run database/schema.sql automatically when the database is empty.
AUTO_INIT_DB=true

# Only if the front end is hosted on a different origin than this server (comma separated).
# CORS_ORIGIN=https://your-site.netlify.app
